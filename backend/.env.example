# ==========================================
# ManhwaAI - Environment Configuration
# ==========================================

# 1. Supabase Database (Optional - falls back to local SQLite 'local.db' if empty)
SUPABASE_URL=
SUPABASE_KEY=

# 2. Redis Task Queue (Optional - falls back to local in-memory queue if empty)
# Option A: Standard Redis TCP connection string (e.g. rediss://default:password@host:port)
REDIS_URL=
# Option B: Upstash Redis REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3. Google Gemini AI Studio Key (Optional - uses heuristics fallback parser if empty)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 4. Image Generation Endpoint (Optional if MOCK_IMAGE_GEN=True)
# URL to your hosted Stable Diffusion / FLUX model server (e.g., Kaggle ngrok tunnel or modal)
IMAGE_GEN_URL=https://your-ngrok-subdomain.ngrok-free.app

# 5. Generation Mode
# Set to 'True' for quick local testing with mock placeholder images (no GPU/API needed)
# Set to 'False' to call real Gemini and external Image Generation APIs
MOCK_IMAGE_GEN=True

# 6. Cloudflare R2 / S3 Storage (Optional - defaults to backend/static local hosting)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
